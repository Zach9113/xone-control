    QFrame,
    QHBoxLayout,
    QLabel,
    QMainWindow,
    QPushButton,
    QSlider,
    QSpinBox,
    QVBoxLayout,
    QWidget,
)

CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "xone-control",
)
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
STATE_PATH = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
    "xone-control-state.json",
)

DEFAULT_CONFIG = {
    "idle_enabled": True,
    "idle_timeout_minutes": 15,
    "led_brightness": 20,
    "led_mode": 1,
}

XBOX_BT_PIDS = {
    "02e0",
    "02fd",
    "0b05",
    "0b0a",
    "0b13",
    "0b20",
    "0b22",
}

