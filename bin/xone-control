BATTERY_LEVEL_MAP = {
    "Full": ("100%", "BadgeGreen"),
    "High": ("~75%", "BadgeGreen"),
    "Normal": ("~50%", "BadgeYellow"),
    "Low": ("~20%", "BadgeRed"),
    "Critical": ("~5%", "BadgeRed"),
}


def load_config():
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
            cfg = dict(DEFAULT_CONFIG)
            cfg.update(data)
            return cfg
    except Exception:
        return dict(DEFAULT_CONFIG)


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, CONFIG_PATH)


def find_dongle_dir():
    matches = sorted(glob.glob("/sys/bus/usb/drivers/xone-dongle/*:1.0"))
    return matches[0] if matches else None


def read_sysfs(path, default=""):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read().strip()
    except Exception:
        return default


def write_sysfs(path, value):
    try:
        with open(path, "w", encoding="utf-8") as f:
            f.write(str(value))
        return True
    except Exception:
        return False


def format_duration(seconds):
    if seconds is None:
        return "Disabled"
    m, s = divmod(max(0, int(seconds)), 60)
    return f"{m}m {s:02d}s"


def battery_badge_for_supply(supply_dir):
    if not supply_dir or not os.path.isdir(supply_dir):
        return ("Battery: --", "BadgeGray")
    cap_str = read_sysfs(os.path.join(supply_dir, "capacity"), "")
    if cap_str.isdigit():
        pct = int(cap_str)
        if pct >= 65:
            style = "BadgeGreen"
        elif pct >= 30:
            style = "BadgeYellow"
        else:
            style = "BadgeRed"
        return (f"Battery: {pct}%", style)

    level = read_sysfs(os.path.join(supply_dir, "capacity_level"), "")
    if level in BATTERY_LEVEL_MAP:
        pct_str, style = BATTERY_LEVEL_MAP[level]
        return (f"Battery: {pct_str}", style)
    return ("Battery: --", "BadgeGray")


def find_bt_battery_dir(mac):
    mac_l = mac.lower()
    direct = f"/sys/class/power_supply/hid-{mac_l}-battery"
    if os.path.isdir(direct):
        return direct
    for ps in glob.glob("/sys/class/power_supply/*"):
        if mac_l in os.path.basename(ps).lower():
            return ps
    return None


def discover_controllers(dongle_dir):
    found = []

    if dongle_dir:
        for client_dir in sorted(glob.glob(os.path.join(dongle_dir, "gip*/gip*.*"))):
            client_name = os.path.basename(client_dir)
            slot_str = client_name.split(".")[0][3:]
            fw_ver = read_sysfs(os.path.join(client_dir, "firmware_version"), "")
            fw_suffix = f"  •  FW {fw_ver}" if fw_ver and fw_ver != "0.0.0.0" else ""
            batt_dir = os.path.join(client_dir, "power_supply", client_name)
            found.append(
                {
                    "id": f"xone:{slot_str}",
                    "transport": "xone",
                    "slot": slot_str,
                    "title": f"Xbox Controller (Dongle Slot {slot_str}){fw_suffix}",
                    "batt_dir": batt_dir,
                    "off_label": "Turn Off",
                }
            )

    seen_macs = set()
    for ev_sys in sorted(glob.glob("/sys/class/input/event*")):
        dev_dir = os.path.join(ev_sys, "device")
        if read_sysfs(os.path.join(dev_dir, "id/bustype")).lower() != "0005":
            continue
        if read_sysfs(os.path.join(dev_dir, "id/vendor")).lower() != "045e":
            continue
        product = read_sysfs(os.path.join(dev_dir, "id/product")).lower()
        name = read_sysfs(os.path.join(dev_dir, "name"), "Xbox Wireless Controller")
        if product not in XBOX_BT_PIDS and "xbox" not in name.lower():
            continue
        abs_caps = read_sysfs(os.path.join(dev_dir, "capabilities/abs"), "0")
        if not abs_caps or abs_caps == "0":
            continue
        mac = read_sysfs(os.path.join(dev_dir, "uniq")).upper()
        if not mac or mac in seen_macs:
            continue
        seen_macs.add(mac)
        found.append(
            {
                "id": f"bt:{mac}",
                "transport": "bluetooth",
                "mac": mac,
                "title": f"Xbox Controller (Bluetooth)",
                "batt_dir": find_bt_battery_dir(mac),
                "off_label": "Disconnect",
            }
        )

    return found


class ControllerRow(QFrame):
    def __init__(self, ctrl_id, on_poweroff):
        super().__init__()
        self.setProperty("class", "SlotRow")
        self.ctrl_id = ctrl_id

        v = QVBoxLayout(self)
        v.setContentsMargins(12, 10, 12, 10)
        v.setSpacing(6)

        top = QHBoxLayout()
        self.title_lbl = QLabel()
        self.title_lbl.setProperty("class", "BigStatus")
        top.addWidget(self.title_lbl)
        top.addStretch()

        self.batt_badge = QLabel("Battery: --")
        self.batt_badge.setProperty("class", "BadgeGray")
        top.addWidget(self.batt_badge)
        v.addLayout(top)

        bottom = QHBoxLayout()
        self.idle_lbl = QLabel("Idle timer active")
        self.idle_lbl.setProperty("class", "SubStatus")
        bottom.addWidget(self.idle_lbl)
        bottom.addStretch()

        self.off_btn = QPushButton("Turn Off")
        self.off_btn.setObjectName("SmallDangerBtn")
        self.off_btn.clicked.connect(lambda: on_poweroff(ctrl_id))
        bottom.addWidget(self.off_btn)
        v.addLayout(bottom)

    def update_info(self, title_text, batt_text, badge_class, idle_text, off_label, show_off):
        self.title_lbl.setText(title_text)
        self.batt_badge.setText(batt_text)
        if self.batt_badge.property("class") != badge_class:
            self.batt_badge.setProperty("class", badge_class)
            self.batt_badge.style().unpolish(self.batt_badge)
            self.batt_badge.style().polish(self.batt_badge)
        self.idle_lbl.setText(idle_text)
        self.off_btn.setText(off_label)
        self.off_btn.setVisible(show_off)


class XoneControlWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Xbox Wireless Controller Manager")
        self.setMinimumWidth(520)
        self.cfg = load_config()
        self._updating_ui = False
        self._ctrl_rows = {}
        self._latest_controllers = {}

        root = QWidget()
        root.setObjectName("Root")
        self.setCentralWidget(root)
        layout = QVBoxLayout(root)
        layout.setContentsMargins(18, 18, 18, 18)
        layout.setSpacing(14)

        # Header
        header_row = QHBoxLayout()
        title = QLabel("Xbox Wireless Controller Manager")
        title_font = QFont()
        title_font.setPointSize(14)
        title_font.setBold(True)
        title.setFont(title_font)
        header_row.addWidget(title)
        header_row.addStretch()

        self.dongle_badge = QLabel("Checking...")
        self.dongle_badge.setProperty("class", "BadgeGray")
        header_row.addWidget(self.dongle_badge)
        layout.addLayout(header_row)

        # Card 1: Live Controller & Dongle Status
        status_card = QFrame()
        status_card.setProperty("class", "Card")
        s_layout = QVBoxLayout(status_card)
        s_layout.setContentsMargins(16, 14, 16, 14)
        s_layout.setSpacing(10)

        sec1 = QLabel("LIVE CONTROLLER STATUS")
        sec1.setProperty("class", "SectionTitle")
        s_layout.addWidget(sec1)

        self.empty_title = QLabel("No Controller Connected")
        self.empty_title.setProperty("class", "BigStatus")
        s_layout.addWidget(self.empty_title)

        self.empty_sub = QLabel("Press the Xbox button on your controller to connect.")
        self.empty_sub.setProperty("class", "SubStatus")
        s_layout.addWidget(self.empty_sub)

        self.slots_container = QVBoxLayout()
        self.slots_container.setSpacing(8)
        s_layout.addLayout(self.slots_container)

        btn_row = QHBoxLayout()
        self.pair_btn = QPushButton("Start Dongle Pairing (60s)")
        self.pair_btn.setObjectName("GreenBtn")
        self.pair_btn.clicked.connect(self.toggle_pairing)
        btn_row.addWidget(self.pair_btn)

        self.poweroff_btn = QPushButton("Turn Off Controller Now")
        self.poweroff_btn.setObjectName("DangerBtn")
        self.poweroff_btn.clicked.connect(self.poweroff_all)
        btn_row.addWidget(self.poweroff_btn)
        s_layout.addLayout(btn_row)

        layout.addWidget(status_card)

        # Card 2: Idle Auto-Shutoff Timer
        idle_card = QFrame()
        idle_card.setProperty("class", "Card")
        i_layout = QVBoxLayout(idle_card)
        i_layout.setContentsMargins(16, 14, 16, 14)
        i_layout.setSpacing(10)

        sec2 = QLabel("IDLE AUTO-SHUTOFF TIMER")
        sec2.setProperty("class", "SectionTitle")
        i_layout.addWidget(sec2)

        idle_top = QHBoxLayout()
        self.idle_chk = QCheckBox("Automatically turn off controller when inactive")
        self.idle_chk.setChecked(bool(self.cfg.get("idle_enabled", True)))
        self.idle_chk.toggled.connect(self.on_idle_changed)
        idle_top.addWidget(self.idle_chk)
        idle_top.addStretch()
        i_layout.addLayout(idle_top)

        spin_row = QHBoxLayout()
        spin_row.addWidget(QLabel("Turn off after:"))

        self.idle_slider = QSlider(Qt.Orientation.Horizontal)
        self.idle_slider.setRange(1, 60)
        self.idle_slider.setValue(int(self.cfg.get("idle_timeout_minutes", 15)))
        self.idle_slider.valueChanged.connect(self.on_idle_slider_changed)
        spin_row.addWidget(self.idle_slider, 1)

        self.idle_spin = QSpinBox()
        self.idle_spin.setRange(1, 120)
        self.idle_spin.setSuffix(" min")
        self.idle_spin.setValue(int(self.cfg.get("idle_timeout_minutes", 15)))
        self.idle_spin.valueChanged.connect(self.on_idle_spin_changed)
        spin_row.addWidget(self.idle_spin)
        i_layout.addLayout(spin_row)

        self.idle_slider.setEnabled(self.idle_chk.isChecked())
        self.idle_spin.setEnabled(self.idle_chk.isChecked())

        preset_row = QHBoxLayout()
        preset_lbl = QLabel("Quick presets:")
        preset_lbl.setProperty("class", "SubStatus")
        preset_row.addWidget(preset_lbl)
        for mins in (5, 10, 15, 20, 30):
            p_btn = QPushButton(f"{mins}m")
            p_btn.setObjectName("PresetBtn")
            p_btn.clicked.connect(lambda checked=False, m=mins: self.set_idle_preset(m))
            preset_row.addWidget(p_btn)
        preset_row.addStretch()
        i_layout.addLayout(preset_row)

        layout.addWidget(idle_card)

        # Card 3: Xbox Guide Button LED (xone dongle only)
        led_card = QFrame()
        led_card.setProperty("class", "Card")
        l_layout = QVBoxLayout(led_card)
        l_layout.setContentsMargins(16, 14, 16, 14)
        l_layout.setSpacing(10)

        sec3 = QLabel("XBOX GUIDE BUTTON LED (XONE DONGLE)")
        sec3.setProperty("class", "SectionTitle")
        l_layout.addWidget(sec3)

        self.led_hint = QLabel("LED brightness & mode require an Xbox Wireless Adapter (xone). Not supported over Bluetooth.")
        self.led_hint.setProperty("class", "HintLabel")
        self.led_hint.setWordWrap(True)
        self.led_hint.setVisible(False)
        l_layout.addWidget(self.led_hint)

        b_row = QHBoxLayout()
        b_row.addWidget(QLabel("Brightness:"))
        self.led_slider = QSlider(Qt.Orientation.Horizontal)
        self.led_slider.setRange(0, 50)
        self.led_slider.setValue(int(self.cfg.get("led_brightness", 20)))
        self.led_slider.valueChanged.connect(self.on_led_changed)
        b_row.addWidget(self.led_slider, 1)

        self.led_val_label = QLabel(f"{self.led_slider.value()} / 50")
        self.led_val_label.setMinimumWidth(55)
        self.led_val_label.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
        b_row.addWidget(self.led_val_label)
        l_layout.addLayout(b_row)

        m_row = QHBoxLayout()
        m_row.addWidget(QLabel("LED Mode:"))
        self.mode_combo = QComboBox()
        self.mode_combo.addItem("Off (0)", 0)
        self.mode_combo.addItem("Solid On (1)", 1)
        self.mode_combo.addItem("Fast Blink (2)", 2)
        self.mode_combo.addItem("Slow Blink (3)", 3)
        self.mode_combo.addItem("Breathing / Pulse (4)", 4)
        saved_mode = int(self.cfg.get("led_mode", 1))
        idx = self.mode_combo.findData(saved_mode)
        if idx >= 0:
            self.mode_combo.setCurrentIndex(idx)
        self.mode_combo.currentIndexChanged.connect(self.on_led_changed)
        m_row.addWidget(self.mode_combo, 1)
        l_layout.addLayout(m_row)

        layout.addWidget(led_card)

        self.setStyleSheet(STYLESHEET)

        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh_status)
        self.timer.start(1000)
        self.refresh_status()

    def set_badge_style(self, label, style_class):
        if label.property("class") != style_class:
            label.setProperty("class", style_class)
            label.style().unpolish(label)
            label.style().polish(label)

    def set_idle_preset(self, minutes):
        self.idle_chk.setChecked(True)
        self.idle_spin.setValue(minutes)

    def on_idle_slider_changed(self, val):
        if self._updating_ui:
            return
        self._updating_ui = True
        self.idle_spin.setValue(val)
        self._updating_ui = False
        self.save_settings()

    def on_idle_spin_changed(self, val):
        if self._updating_ui:
            return
        self._updating_ui = True
        if val <= 60:
            self.idle_slider.setValue(val)
        self._updating_ui = False
        self.save_settings()

    def on_idle_changed(self):
        if self._updating_ui:
            return
        self.idle_slider.setEnabled(self.idle_chk.isChecked())
        self.idle_spin.setEnabled(self.idle_chk.isChecked())
        self.save_settings()

    def on_led_changed(self):
        if self._updating_ui:
            return
        b_val = self.led_slider.value()
        m_val = self.mode_combo.currentData()
        self.led_val_label.setText(f"{b_val} / 50")
        self.save_settings()

        for led_dir in glob.glob("/sys/class/leds/gip*:white:status"):
            write_sysfs(os.path.join(led_dir, "brightness"), b_val)
            write_sysfs(os.path.join(led_dir, "mode"), m_val)

    def save_settings(self):
        self.cfg["idle_enabled"] = self.idle_chk.isChecked()
        self.cfg["idle_timeout_minutes"] = self.idle_spin.value()
        self.cfg["led_brightness"] = self.led_slider.value()
        self.cfg["led_mode"] = self.mode_combo.currentData()
        save_config(self.cfg)

    def toggle_pairing(self):
        dongle_dir = find_dongle_dir()
        if not dongle_dir:
            return
        p_path = os.path.join(dongle_dir, "pairing")
        cur = read_sysfs(p_path, "0")
        write_sysfs(p_path, "0" if cur == "1" else "1")
        self.refresh_status()

    def poweroff_one(self, ctrl_id):
        ctrl = self._latest_controllers.get(ctrl_id)
        if not ctrl:
            return
        if ctrl["transport"] == "xone":
            dongle_dir = find_dongle_dir()
            if dongle_dir:
                write_sysfs(os.path.join(dongle_dir, "poweroff"), str(ctrl["slot"]))
        elif ctrl["transport"] == "bluetooth":
            try:
                subprocess.Popen(
                    ["bluetoothctl", "disconnect", ctrl["mac"]],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            except Exception:
                pass
        self.refresh_status()

    def poweroff_all(self):
        dongle_dir = find_dongle_dir()
        has_xone = any(c["transport"] == "xone" for c in self._latest_controllers.values())
        if dongle_dir and has_xone:
            write_sysfs(os.path.join(dongle_dir, "poweroff"), "-1")
        for ctrl in self._latest_controllers.values():
            if ctrl["transport"] == "bluetooth":
                try:
                    subprocess.Popen(
                        ["bluetoothctl", "disconnect", ctrl["mac"]],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                    )
                except Exception:
                    pass
        self.refresh_status()

    def _clear_ctrl_rows(self, keep_ids):
        for cid in list(self._ctrl_rows.keys()):
            if cid not in keep_ids:
                row = self._ctrl_rows.pop(cid)
                self.slots_container.removeWidget(row)
                row.deleteLater()

    def refresh_status(self):
        dongle_dir = find_dongle_dir()
        controllers = discover_controllers(dongle_dir)
        self._latest_controllers = {c["id"]: c for c in controllers}

        has_bt = any(c["transport"] == "bluetooth" for c in controllers)
        has_dongle = dongle_dir is not None

        if has_dongle:
            self.pair_btn.setVisible(True)
            self.pair_btn.setEnabled(True)
            self.led_slider.setEnabled(True)
            self.mode_combo.setEnabled(True)
            self.led_hint.setVisible(False)
            pairing = read_sysfs(os.path.join(dongle_dir, "pairing"), "0") == "1"
            if pairing:
                self.dongle_badge.setText("Dongle: Pairing Active")
                self.set_badge_style(self.dongle_badge, "BadgeBlue")
                self.pair_btn.setText("Stop Pairing Mode")
            else:
                self.dongle_badge.setText("Dongle: Ready")
                self.set_badge_style(self.dongle_badge, "BadgeGreen")
                self.pair_btn.setText("Start Dongle Pairing (60s)")
        else:
            self.pair_btn.setVisible(False)
            self.led_slider.setEnabled(False)
            self.mode_combo.setEnabled(False)
            self.led_hint.setVisible(True)
            if has_bt:
                self.dongle_badge.setText("Bluetooth Active")
                self.set_badge_style(self.dongle_badge, "BadgeBlue")
            else:
                self.dongle_badge.setText("Bluetooth Ready")
                self.set_badge_style(self.dongle_badge, "BadgeGray")

        if not controllers:
            self._clear_ctrl_rows(set())
            self.empty_title.setText("No Controller Connected")
            self.empty_title.setVisible(True)
            self.empty_sub.setText(
                "Press the Xbox button on your controller to connect via dongle or Bluetooth."
            )
            self.empty_sub.setVisible(True)
            self.poweroff_btn.setEnabled(False)
            self.poweroff_btn.setText("Turn Off Controller Now")
            return

        self.empty_title.setVisible(False)
        self.empty_sub.setVisible(False)
        self.poweroff_btn.setEnabled(True)
        multi = len(controllers) > 1
        if multi:
            self.poweroff_btn.setText("Turn Off / Disconnect All")
        elif controllers[0]["transport"] == "bluetooth":
            self.poweroff_btn.setText("Disconnect Controller Now")
        else:
            self.poweroff_btn.setText("Turn Off Controller Now")

        daemon_ctrls = {}
        try:
            with open(STATE_PATH, "r", encoding="utf-8") as f:
                daemon_ctrls = json.load(f).get("controllers", {})
        except Exception:
            pass

        active_ids = set()
        for ctrl in controllers:
            cid = ctrl["id"]
            active_ids.add(cid)
            if cid not in self._ctrl_rows:
                row = ControllerRow(cid, self.poweroff_one)
                self._ctrl_rows[cid] = row
                self.slots_container.addWidget(row)

            batt_text, badge_style = battery_badge_for_supply(ctrl["batt_dir"])
            idle_text = "Idle timer active"
            st_info = daemon_ctrls.get(cid)
            if st_info:
                idle_s = st_info.get("idle_seconds", 0)
                rem_s = st_info.get("remaining_seconds")
                if rem_s is not None:
                    idle_text = f"Idle for {format_duration(idle_s)}  •  Auto-off in {format_duration(rem_s)}"
                else:
                    idle_text = f"Idle for {format_duration(idle_s)}  •  Auto-off disabled"

            self._ctrl_rows[cid].update_info(
                ctrl["title"],
                batt_text,
                badge_style,
                idle_text,
                ctrl["off_label"],
                multi,
            )

        self._clear_ctrl_rows(active_ids)


def main():
    app = QApplication(sys.argv)
    win = XoneControlWindow()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
