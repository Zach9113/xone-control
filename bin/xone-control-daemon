#!/usr/bin/env python3
"""
xone-control-daemon — Background idle auto-shutoff & LED manager for Xbox Wireless Controllers
(supports both Linux `xone` USB wireless dongles and Bluetooth Xbox controllers via BlueZ).
License: GPL-3.0-or-later
"""

import glob
import json
import os
import select
import struct
import subprocess
import time

CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "xone-control",
)
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
STATE_PATH = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
    "xone-control-state.json",
)

DEFAULT_CONFIG = {
    "idle_enabled": True,
    "idle_timeout_minutes": 15,
    "led_brightness": 20,
    "led_mode": 1,
}

# Known Microsoft Xbox Bluetooth PIDs
XBOX_BT_PIDS = {
    "02e0",  # Xbox One S (BT)
    "02fd",  # Xbox One S (BT newer firmware)
    "0b05",  # Xbox Elite Series 2 (BT)
    "0b0a",  # Xbox Adaptive Controller (BT)
    "0b13",  # Xbox Series X|S (BT)
    "0b20",  # Xbox Wireless Controller (BLE)
    "0b22",  # Xbox Elite Series 2 (BLE)
}

# struct input_event on 64-bit Linux: timeval (q, q), type (H), code (H), value (i)
INPUT_EVENT_STRUCT = struct.Struct("qqHHi")

EV_KEY = 0x01
EV_ABS = 0x03

# Deadzone thresholds so slight stick drift doesn't reset the idle timer
STICK_DEADZONE_DELTA = 1800
TRIGGER_DEADZONE_DELTA = 35


def read_text(path, default=""):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read().strip()
    except Exception:
        return default


def load_config():
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
            cfg = dict(DEFAULT_CONFIG)
            cfg.update(data)
            return cfg
    except Exception:
        return dict(DEFAULT_CONFIG)


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, CONFIG_PATH)


def find_dongle_dir():
    matches = sorted(glob.glob("/sys/bus/usb/drivers/xone-dongle/*:1.0"))
    return matches[0] if matches else None


def find_xone_controllers(dongle_dir):
    controllers = {}
    if not dongle_dir:
        return controllers
    for gip_dir in sorted(glob.glob(os.path.join(dongle_dir, "gip*"))):
        base = os.path.basename(gip_dir)
        if not base[3:].isdigit():
            continue
        idx = int(base[3:])
        client_dirs = sorted(glob.glob(os.path.join(gip_dir, f"{base}.*")))
        if not client_dirs:
            continue
        client_dir = client_dirs[0]
        client_name = os.path.basename(client_dir)

        ev_dirs = glob.glob(os.path.join(client_dir, "input/input*/event*"))
        ev_dev = None
        if ev_dirs:
            ev_name = os.path.basename(ev_dirs[0])
            candidate = f"/dev/input/{ev_name}"
            if os.path.exists(candidate):
                ev_dev = candidate

        led_dir = os.path.join(client_dir, "leds", f"{client_name}:white:status")
        cid = f"xone:{idx}"
        controllers[cid] = {
            "id": cid,
            "transport": "xone",
            "slot": idx,
            "dongle_dir": dongle_dir,
            "event_dev": ev_dev,
            "led_dir": led_dir if os.path.isdir(led_dir) else None,
        }
    return controllers


def find_bt_controllers():
    controllers = {}
    for ev_sys in sorted(glob.glob("/sys/class/input/event*")):
        ev_name = os.path.basename(ev_sys)
        dev_dir = os.path.join(ev_sys, "device")
        bustype = read_text(os.path.join(dev_dir, "id/bustype")).lower()
        if bustype != "0005":
            continue
        vendor = read_text(os.path.join(dev_dir, "id/vendor")).lower()
        if vendor != "045e":
            continue
        product = read_text(os.path.join(dev_dir, "id/product")).lower()
        name = read_text(os.path.join(dev_dir, "name"))
        if product not in XBOX_BT_PIDS and "xbox" not in name.lower():
            continue

        # Skip non-gamepad subdevices (e.g. consumer control / keyboard)
        abs_caps = read_text(os.path.join(dev_dir, "capabilities/abs"), "0").strip()
        if not abs_caps or abs_caps == "0":
            continue

        mac = read_text(os.path.join(dev_dir, "uniq")).upper()
        if not mac:
            continue

        ev_dev = f"/dev/input/{ev_name}"
        if not os.path.exists(ev_dev):
            continue

        cid = f"bt:{mac}"
        if cid not in controllers:
            controllers[cid] = {
                "id": cid,
                "transport": "bluetooth",
                "mac": mac,
                "event_dev": ev_dev,
                "led_dir": None,
            }
    return controllers


def apply_led(ctrl, brightness, mode):
    led_dir = ctrl.get("led_dir")
    if not led_dir:
        return
    try:
        with open(os.path.join(led_dir, "brightness"), "w", encoding="utf-8") as f:
            f.write(str(int(brightness)))
        with open(os.path.join(led_dir, "mode"), "w", encoding="utf-8") as f:
            f.write(str(int(mode)))
    except Exception:
        pass


def poweroff_controller(ctrl):
    if ctrl["transport"] == "xone":
        dongle_dir = ctrl.get("dongle_dir")
        if not dongle_dir:
            return False
        try:
            with open(os.path.join(dongle_dir, "poweroff"), "w", encoding="utf-8") as f:
                f.write(str(int(ctrl["slot"])))
            return True
        except Exception:
            return False
    elif ctrl["transport"] == "bluetooth":
        mac = ctrl.get("mac")
        if not mac:
            return False
        try:
            res = subprocess.run(
                ["bluetoothctl", "disconnect", mac],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
                check=False,
            )
            return res.returncode == 0
        except Exception:
            return False
    return False


def main():
    if not os.path.exists(CONFIG_PATH):
        save_config(DEFAULT_CONFIG)

    last_cfg_mtime = 0
    cfg = load_config()
    tracked = {}

    while True:
        now = time.time()

        try:
            mtime = os.path.getmtime(CONFIG_PATH)
            if mtime != last_cfg_mtime:
                cfg = load_config()
                last_cfg_mtime = mtime
                for info in tracked.values():
                    info["led_applied"] = False
        except Exception:
            pass

        dongle_dir = find_dongle_dir()
        controllers = find_xone_controllers(dongle_dir)
        controllers.update(find_bt_controllers())

        for cid in list(tracked.keys()):
            if cid not in controllers or tracked[cid]["event_dev"] != controllers[cid]["event_dev"]:
                fd = tracked[cid].get("fd")
                if fd is not None:
                    try:
                        os.close(fd)
                    except Exception:
                        pass
                del tracked[cid]

        for cid, ctrl in controllers.items():
            if cid not in tracked:
                fd = None
                ev_dev = ctrl.get("event_dev")
                if ev_dev:
                    try:
                        fd = os.open(ev_dev, os.O_RDONLY | os.O_NONBLOCK)
                    except Exception:
                        fd = None
                tracked[cid] = {
                    "fd": fd,
                    "event_dev": ev_dev,
                    "last_active": now,
                    "axes": {},
                    "led_applied": False,
                }
            if not tracked[cid]["led_applied"] and ctrl.get("led_dir"):
                apply_led(ctrl, cfg.get("led_brightness", 20), cfg.get("led_mode", 1))
                tracked[cid]["led_applied"] = True

        fd_to_cid = {info["fd"]: cid for cid, info in tracked.items() if info["fd"] is not None}
        if fd_to_cid:
            try:
                rlist, _, _ = select.select(list(fd_to_cid.keys()), [], [], 1.0)
            except Exception:
                rlist = []

            now = time.time()
            for fd in rlist:
                cid = fd_to_cid.get(fd)
                if cid is None or cid not in tracked:
                    continue
                t_info = tracked[cid]
                try:
                    data = os.read(fd, INPUT_EVENT_STRUCT.size * 64)
                except BlockingIOError:
                    continue
                except OSError:
                    try:
                        os.close(fd)
                    except Exception:
                        pass
                    t_info["fd"] = None
                    continue

                offset = 0
                meaningful = False
                while offset + INPUT_EVENT_STRUCT.size <= len(data):
                    _, _, ev_type, ev_code, ev_val = INPUT_EVENT_STRUCT.unpack_from(data, offset)
                    offset += INPUT_EVENT_STRUCT.size
                    if ev_type == EV_KEY and ev_val != 0:
                        meaningful = True
                    elif ev_type == EV_ABS:
                        if ev_code in (16, 17):
                            if ev_val != 0:
                                meaningful = True
                        elif ev_code in (2, 5):
                            if ev_val > TRIGGER_DEADZONE_DELTA:
                                meaningful = True
                        else:
                            prev = t_info["axes"].get(ev_code, ev_val)
                            if abs(ev_val - prev) > STICK_DEADZONE_DELTA or abs(ev_val) > 6500:
                                meaningful = True
                            t_info["axes"][ev_code] = ev_val

                if meaningful:
                    t_info["last_active"] = now
        else:
            time.sleep(1.5)

        now = time.time()
        timeout_sec = max(1, int(cfg.get("idle_timeout_minutes", 15))) * 60
        idle_enabled = bool(cfg.get("idle_enabled", True))

        state_controllers = {}
        for cid, t_info in list(tracked.items()):
            idle_sec = max(0, int(now - t_info["last_active"]))
            rem_sec = max(0, timeout_sec - idle_sec) if idle_enabled else None
            state_controllers[cid] = {
                "idle_seconds": idle_sec,
                "remaining_seconds": rem_sec,
            }
            if idle_enabled and idle_sec >= timeout_sec and cid in controllers:
                if poweroff_controller(controllers[cid]):
                    t_info["last_active"] = now

        try:
            tmp_state = STATE_PATH + ".tmp"
            with open(tmp_state, "w", encoding="utf-8") as f:
                json.dump({"updated": now, "controllers": state_controllers}, f)
            os.replace(tmp_state, STATE_PATH)
        except Exception:
            pass


if __name__ == "__main__":
    main()
